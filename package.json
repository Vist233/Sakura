{
  "name": "sakura-agent",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "packages/plugins/*"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check": "npm run check:boundaries && npm run typecheck && npm run lint && npm run format:check && npm test",
    "coverage": "vitest run --coverage --coverage.provider=v8 --coverage.reporter=text --coverage.include='packages/**/src/**' --coverage.exclude='**/rules.gen.ts'",
    "test:unit": "vitest run --project unit",
    "test:contract": "vitest run --project contract",
    "test:tools": "vitest run --project tools",
    "test:pkg": "vitest run --project unit --project contract",
    "lint": "biome lint",
    "format": "biome format --write",
    "format:check": "biome format",
    "example": "node examples/quickstart.ts",
    "build": "node scripts/build-sdk.mjs",
    "prepack": "npm run build",
    "example:tools": "node examples/tools.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.0.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=26"
  },
  "description": "An embeddable TypeScript SDK and CLI for coding agents with resumable sessions and configurable tools.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vist233/Sakura.git"
  },
  "homepage": "https://github.com/Vist233/Sakura#readme",
  "bugs": {
    "url": "https://github.com/Vist233/Sakura/issues"
  },
  "keywords": [
    "agent-framework",
    "coding-agent",
    "typescript",
    "llm",
    "mcp"
  ],
  "exports": {
    ".": {
      "types": "./dist/sdk/index.d.ts",
      "import": "./dist/sdk/index.js"
    },
    "./testing": {
      "types": "./dist/sdk/testing.d.ts",
      "import": "./dist/sdk/testing.js"
    }
  },
  "types": "./dist/sdk/index.d.ts",
  "bin": {
    "sakura": "./dist/sdk/cli.js"
  },
  "files": [
    "dist",
    "README.zh-CN.md",
    "THIRD_PARTY_NOTICES.md",
    "licenses"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "quickjs-emscripten": "^0.32.0"
  }
}
