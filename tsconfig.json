{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "packages/**/src/**/*.ts",
    "packages/**/test/**/*.ts",
    "scripts/test/**/*.ts",
    "examples/**/*.ts",
    "sdk/**/*.ts"
  ]
}
