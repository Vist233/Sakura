{
  "name": "sakuracode",
  "version": "0.1.1",
  "license": "MIT",
  "type": "module",
  "description": "sakuracode: an open-source terminal coding agent (command-line AI coding assistant) with automatic review of every tool call. Works with DeepSeek, OpenCode Go and any OpenAI-compatible endpoint.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vist233/Sakura.git",
    "directory": "code"
  },
  "bin": {
    "sakuracode": "dist/code/bin/sakuracode.mjs"
  },
  "imports": {
    "#manifest": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning bin/sakuracode.mjs",
    "test": "node --disable-warning=ExperimentalWarning --test --test-concurrency=2 \"test/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json",
    "build": "node ../scripts/build-sdk.mjs --code",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=26"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "2.4.0",
    "quickjs-emscripten": "^0.32.0",
    "zod": "4.6.7"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "coding-agent",
    "ai-coding-assistant",
    "terminal",
    "cli",
    "agent",
    "llm",
    "deepseek",
    "opencode",
    "codex-cli-alternative",
    "claude-code-alternative",
    "mcp",
    "sakura"
  ],
  "homepage": "https://github.com/Vist233/Sakura/tree/main/code#readme",
  "bugs": {
    "url": "https://github.com/Vist233/Sakura/issues"
  }
}
